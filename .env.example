# Workbase — environment variables (copy to .env locally, or set in Railway's dashboard)
# Placeholders only — never commit real secrets to git.

# --- Database ---
# PostgreSQL connection string. On Railway this is provided by the Postgres
# plugin as a reference variable. Leave unset locally to use the JSON file store.
DATABASE_URL=postgres://user:password@host:5432/database

# --- Sessions ---
# Long random string used to sign session/reset tokens. Generate one, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

# --- Public URL of this deployment (used in password-reset email links) ---
APP_URL=https://app.example.com

# --- Signup mode / seats / pricing (config only) ---
# Signup is invite-only: after the Owner account is created, admins create all accounts.
PUBLIC_SIGNUP=invite
SEAT_LIMIT=78
SEAT_PRICE_USD=15

# --- Email (Resend) ---
# With RESEND_API_KEY set, password-reset links are emailed via Resend.
# Without it (local dev), reset tokens are shown on screen instead.
RESEND_API_KEY=re_replace_with_your_resend_api_key
EMAIL_FROM=Workbase <noreply@example.com>

# --- SSO (enabled at deployment against the City's identity provider) ---
# SSO is switched on in the deployment environment once the City's IdP
# (e.g. Microsoft Entra ID / Okta, SAML or OIDC) is registered — see DEPLOY.md.
# The app ships with SSO off; email/password login always remains available
# for the Owner/admin break-glass account unless enforcement is configured.
SSO_ENABLED=false
SSO_PROVIDER=
SSO_ISSUER_URL=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=

# --- Microsoft Teams (can also be set in the app: Chat — Microsoft Teams) ---
TEAMS_WEBHOOK_URL=
